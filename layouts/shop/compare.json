{
  "version": "1.0.0",
  "layout_name": "shop/compare",
  "permissions": [],
  "extends": "_user_base",
  "meta": {
    "title": "$t:lusento-catalog.catalog.compare.title",
    "description": "$t:lusento-catalog.catalog.compare.description"
  },
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "local",
        "differentOnly": false
      }
    }
  ],
  "data_sources": [
    {
      "id": "comparison",
      "type": "api",
      "endpoint": "/api/modules/lusento-catalog/catalog/compare",
      "method": "GET",
      "params": {
        "products": "{{query.products ?? ''}}",
        "category_slug": "{{query.category_slug ?? ''}}"
      },
      "auto_fetch": true,
      "loading_strategy": "progressive",
      "fallback": {
        "data": {
          "products": [],
          "specs": [],
          "category": null
        }
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "layout",
        "name": "Container",
        "props": {
          "className": "py-8"
        },
        "children": [
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-6"
            },
            "children": [
              {
                "type": "basic",
                "name": "H1",
                "props": {
                  "className": "text-2xl md:text-3xl font-bold text-gray-900 dark:text-white"
                },
                "text": "$t:lusento-catalog.catalog.compare.title"
              },
              {
                "type": "basic",
                "name": "P",
                "props": {
                  "className": "mt-2 text-sm text-gray-500 dark:text-gray-400"
                },
                "text": "$t:lusento-catalog.catalog.compare.description"
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{(comparison?.data?.products ?? []).length < 2}}",
            "props": {
              "className": "py-20 text-center border border-dashed border-gray-300 dark:border-gray-700 rounded-xl"
            },
            "children": [
              {
                "type": "basic",
                "name": "Icon",
                "props": {
                  "name": "columns",
                  "size": "2x",
                  "className": "text-gray-300 dark:text-gray-600"
                }
              },
              {
                "type": "basic",
                "name": "P",
                "props": {
                  "className": "mt-4 text-gray-600 dark:text-gray-300"
                },
                "text": "{{_dataSourceErrors?.comparison?.errors?.products?.[0] ?? _dataSourceErrors?.comparison?.message ?? $t('lusento-catalog.catalog.compare.empty')}}"
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {
                  "className": "mt-4 px-4 py-2 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900 text-sm font-medium"
                },
                "text": "$t:lusento-catalog.catalog.compare.back",
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "params": {
                      "path": "{{_global.shopBase}}/products",
                      "mergeQuery": true,
                      "query": {
                        "products": null
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "basic",
            "name": "Div",
            "if": "{{(comparison?.data?.products ?? []).length >= 2}}",
            "children": [
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "flex items-center justify-between gap-3 mb-4"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Button",
                    "props": {
                      "className": "text-sm text-gray-500 hover:text-gray-900 dark:hover:text-white"
                    },
                    "text": "$t:lusento-catalog.catalog.compare.back",
                    "actions": [
                      {
                        "type": "click",
                        "handler": "navigate",
                        "params": {
                          "path": "{{(_global.shopBase ?? '') + (query.category_slug ? '/category/' + query.category_slug : '/products')}}",
                          "mergeQuery": true,
                          "query": {
                            "products": null
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "Button",
                    "props": {
                      "className": "px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 text-sm text-gray-700 dark:text-gray-200"
                    },
                    "text": "{{_local.differentOnly ? $t('lusento-catalog.catalog.compare.show_all') : $t('lusento-catalog.catalog.compare.different_only')}}",
                    "actions": [
                      {
                        "type": "click",
                        "handler": "setState",
                        "params": {
                          "target": "local",
                          "differentOnly": "{{!_local.differentOnly}}"
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "catalog_compare_highlights",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "mb-6 rounded-lg border border-gray-200 dark:border-gray-700 p-4"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H2",
                    "props": {
                      "className": "text-base font-semibold text-gray-900 dark:text-white"
                    },
                    "text": "$t:lusento-catalog.catalog.compare.highlights"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "mt-1 text-xs text-gray-500 dark:text-gray-400"
                    },
                    "text": "$t:lusento-catalog.catalog.compare.highlights_notice"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "mt-3 text-sm text-gray-600 dark:text-gray-300"
                    },
                    "text": "$t:lusento-catalog.catalog.compare.highlights_empty",
                    "if": "{{(comparison?.data?.highlights ?? []).length === 0}}"
                  },
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "mt-4 grid gap-3 md:grid-cols-3"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Div",
                        "iteration": {
                          "source": "{{comparison?.data?.highlights ?? []}}",
                          "item_var": "highlight"
                        },
                        "props": {
                          "className": "min-w-0 rounded-lg bg-gray-50 dark:bg-gray-800 p-3"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "H3",
                            "props": {
                              "className": "font-semibold text-sm"
                            },
                            "text": "{{highlight.label ?? ''}}"
                          },
                          {
                            "type": "basic",
                            "name": "P",
                            "iteration": {
                              "source": "{{comparison?.data?.products ?? []}}",
                              "item_var": "highlightProduct"
                            },
                            "props": {
                              "className": "mt-2 text-sm break-words"
                            },
                            "children": [
                              {
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                  "className": "block text-xs text-gray-500 dark:text-gray-400"
                                },
                                "text": "{{highlightProduct.name_localized ?? $localized(highlightProduct.name) ?? highlightProduct.product_code}}"
                              },
                              {
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                  "className": "font-medium"
                                },
                                "text": "{{highlight.values?.[highlightProduct.product_code] ?? ''}}"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "overflow-x-auto pb-4"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "min-w-[760px] border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                          "className": "flex bg-white dark:bg-gray-900"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                              "className": "w-44 shrink-0 p-4 bg-gray-50 dark:bg-gray-800 text-sm font-semibold text-gray-600 dark:text-gray-300"
                            },
                            "text": "$t:lusento-catalog.catalog.compare.product"
                          },
                          {
                            "type": "basic",
                            "name": "Div",
                            "iteration": {
                              "source": "{{comparison?.data?.products ?? []}}",
                              "item_var": "compareProduct"
                            },
                            "props": {
                              "className": "flex-1 min-w-[190px] p-4 border-l border-gray-200 dark:border-gray-700"
                            },
                            "children": [
                              {
                                "type": "basic",
                                "name": "Img",
                                "props": {
                                  "src": "{{compareProduct.thumbnail_url}}",
                                  "alt": "{{compareProduct.name_localized}}",
                                  "className": "w-24 h-24 mx-auto object-cover rounded-lg bg-gray-100 dark:bg-gray-800"
                                }
                              },
                              {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                  "className": "mt-3 text-center font-semibold text-sm text-gray-900 dark:text-white line-clamp-2"
                                },
                                "text": "{{compareProduct.name_localized}}"
                              },
                              {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                  "className": "mt-1 text-center font-bold text-gray-900 dark:text-white"
                                },
                                "text": "{{compareProduct.selling_price_formatted}}"
                              },
                              {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                  "className": "mt-3 flex justify-center gap-2"
                                },
                                "children": [
                                  {
                                    "type": "basic",
                                    "name": "Button",
                                    "props": {
                                      "className": "px-2 py-1 text-xs rounded border border-gray-300 dark:border-gray-600"
                                    },
                                    "text": "$t:lusento-catalog.catalog.compare.detail",
                                    "actions": [
                                      {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                          "path": "{{_global.shopBase}}/products/{{compareProduct.product_code}}",
                                          "mergeQuery": true,
                                          "query": {
                                            "products": null
                                          }
                                        }
                                      }
                                    ]
                                  },
                                  {
                                    "type": "basic",
                                    "name": "Button",
                                    "props": {
                                      "disabled": "{{(comparison?.data?.products ?? []).length <= 2}}",
                                      "className": "px-2 py-1 text-xs rounded text-gray-500 {{(comparison?.data?.products ?? []).length <= 2 ? 'opacity-40 cursor-not-allowed' : 'hover:text-red-600'}}"
                                    },
                                    "text": "$t:lusento-catalog.catalog.compare.remove",
                                    "actions": [
                                      {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                          "path": "{{route.path}}",
                                          "replace": true,
                                          "query": {
                                            "products": null,
                                            "category_slug": "{{query.category_slug ?? ''}}"
                                          },
                                          "mergeQuery": true
                                        }
                                      }
                                    ]
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "type": "basic",
                        "name": "Div",
                        "iteration": {
                          "source": "{{comparison?.data?.specs ?? []}}",
                          "item_var": "spec"
                        },
                        "if": "{{!_local.differentOnly || spec.is_different}}",
                        "props": {
                          "className": "flex border-t border-gray-200 dark:border-gray-700"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Div",
                            "props": {
                              "className": "w-44 shrink-0 px-4 py-3 bg-gray-50 dark:bg-gray-800 text-sm font-medium text-gray-600 dark:text-gray-300"
                            },
                            "text": "{{spec.label}}"
                          },
                          {
                            "type": "basic",
                            "name": "Div",
                            "iteration": {
                              "source": "{{comparison?.data?.products ?? []}}",
                              "item_var": "compareProduct"
                            },
                            "props": {
                              "className": "flex-1 min-w-[190px] px-4 py-3 border-l border-gray-200 dark:border-gray-700 text-sm text-gray-900 dark:text-white {{(spec.best_products ?? []).includes(compareProduct.product_code) ? 'bg-emerald-50 dark:bg-emerald-900/20 font-semibold' : 'bg-white dark:bg-gray-900'}}"
                            },
                            "children": [
                              {
                                "type": "basic",
                                "name": "Span",
                                "text": "{{spec.values?.[compareProduct.product_code] || '-'}}"
                              },
                              {
                                "type": "basic",
                                "name": "Span",
                                "if": "{{(spec.best_products ?? []).includes(compareProduct.product_code)}}",
                                "props": {
                                  "className": "ml-2 text-xs text-emerald-600 dark:text-emerald-400"
                                },
                                "text": "$t:lusento-catalog.catalog.compare.better"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
